# copies of real packs' native_experts.txt, parsed byte for byte by tests/core/expert_layout_test.cpp
tests/data/native_experts/** -text
# the table is checked byte for byte (tools/check_benchmarks.py), so it stays LF on every checkout
docs/community/benchmarks.json text eol=lf
# a batch file loses its labels and its goto when checked out with LF, so the Windows entry points are CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
